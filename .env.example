# ---- Adzuna (https://developer.adzuna.com/) ----
# Free account. Aggregates listings from Indeed, Reed, Totaljobs, CV-Library, etc for the UK (country code "gb").
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# ---- Reed (https://www.reed.co.uk/developers) ----
# Free account. Reed's API key is used as the HTTP Basic Auth username, password is blank.
REED_API_KEY=your_reed_api_key_here

# ---- Database (Turso / libSQL) ----
# Leave both blank for local development - db.js falls back to a local
# file (./data.db) automatically, no account needed.
# For a hosted deployment (Render, etc), create a free database at
# https://turso.tech and paste its URL + token here so data survives
# restarts/redeploys instead of living on the host's throwaway disk.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Ingest trigger ----
# Required for the /api/ingest endpoint to accept requests (used by the
# GitHub Actions workflow in .github/workflows/hourly-ingest.yml). Make up
# any long random string - it just needs to match what you put in the
# INGEST_SECRET repo secret on GitHub.
INGEST_SECRET=

# Set to "false" on a hosted deployment if you're using the GitHub Actions
# workflow above, so ingest only runs once per external trigger instead of
# also running on the host's own hourly timer. Leave unset/true for local dev.
ENABLE_INTERNAL_CRON=true

# ---- Server ----
PORT=4000

# How often the *internal* cron re-pulls listings, in minutes (only used
# when ENABLE_INTERNAL_CRON is not "false"). Default 60 = hourly.
INGEST_INTERVAL_MINUTES=60
